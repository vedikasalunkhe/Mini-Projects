  /* ---------- PUBLISH CTA / FLYER ---------- */
  .flyer-section{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:60px;
    align-items:center;
  }
  .flyer{
    background:var(--card);
    border:2px solid var(--ink);
    padding:34px;
    position:relative;
    transform:rotate(-1.2deg);
    box-shadow:8px 8px 0 rgba(31,43,34,0.85);
  }
  .flyer::before{
    content:"";
    position:absolute;
    top:-9px; left:50%;
    transform:translateX(-50%);
    width:16px; height:16px;
    border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #ffe07a, #C9971A 70%);
    box-shadow:0 3px 3px rgba(0,0,0,0.35);
  }
  .flyer h3{
    font-size:22px;
    line-height:1.2;
    margin-bottom:14px;
  }
  .flyer .tear{
    display:flex;
    gap:18px;
    margin-top:26px;
    flex-wrap:wrap;
  }
  .flyer-tag{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    border:1px dashed var(--ink-soft);
    padding:5px 9px;
    color:var(--ink-soft);
  }
  .flyer-list{
    list-style:none;
    margin:20px 0 0;
    padding:0;
  }
  .flyer-list li{
    display:flex;
    gap:10px;
    align-items:flex-start;
    font-size:14px;
    padding:8px 0;
    border-bottom:1px dashed var(--line);
    color:var(--ink-soft);
  }
  .flyer-list li:last-child{ border-bottom:none; }
  .flyer-list b{ color:var(--ink); }
  .side-copy h2{
    font-size:clamp(26px,3vw,34px);
    margin-bottom:18px;
  }
  .side-copy p{
    color:var(--ink-soft);
    font-size:15.5px;
    line-height:1.6;
    max-width:42ch;
    margin-bottom:26px;
  }
