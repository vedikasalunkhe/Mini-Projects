<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VeRity — rent it from a classmate</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F4EFE3;
    --paper-dim:#EAE3D2;
    --ink:#1F2B22;
    --ink-soft:#4A564C;
    --tape:#E8B62C;
    --tape-dark:#C9971A;
    --library:#2F5D8A;
    --library-dark:#234872;
    --verified:#3F7A54;
    --card:#FFFDF7;
    --line: rgba(31,43,34,0.14);
    --radius: 3px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3, .display{
    font-family:'Space Grotesk', sans-serif;
    letter-spacing:-0.01em;
    margin:0;
  }
  .mono{
    font-family:'IBM Plex Mono', monospace;
    letter-spacing:0.02em;
  }
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{
    max-width:1180px;
    margin:0 auto;
    padding:0 32px;
  }
  :focus-visible{
    outline:3px solid var(--library);
    outline-offset:3px;
  }

  /* subtle grain / paper texture */
  body::before{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    opacity:0.5;
    z-index:2000;
    background-image:radial-gradient(rgba(31,43,34,0.035) 1px, transparent 1px);
    background-size:3px 3px;
    mix-blend-mode:multiply;
  }

  /* ---------- HEADER ---------- */
  header{
    position:sticky;
    top:0;
    z-index:100;
    background:var(--paper);
    border-bottom:2px solid var(--ink);
  }
  .nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:18px 32px;
  }
  .logo{
    display:flex;
    align-items:baseline;
    gap:8px;
    font-size:24px;
    font-weight:700;
  }
  .logo .dot{
    color:var(--tape-dark);
  }
  .logo-tag{
    font-family:'IBM Plex Mono', monospace;
    font-size:10.5px;
    color:var(--ink-soft);
    text-transform:uppercase;
    letter-spacing:0.12em;
    border-left:2px solid var(--line);
    padding-left:8px;
  }
  nav.links{
    display:flex;
    gap:30px;
    font-size:14.5px;
    font-weight:500;
  }
  nav.links a{
    text-decoration:none;
    position:relative;
    padding-bottom:3px;
  }
  nav.links a:hover{ color:var(--library-dark); }
  .nav-actions{
    display:flex;
    align-items:center;
    gap:14px;
  }
  .btn{
    font-family:'IBM Plex Sans', sans-serif;
    font-weight:600;
    font-size:14px;
    border:2px solid var(--ink);
    background:transparent;
    color:var(--ink);
    padding:10px 18px;
    border-radius:var(--radius);
    cursor:pointer;
    text-decoration:none;
    display:inline-block;
    transition:transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow:3px 3px 0 var(--ink);
  }
  .btn:hover{
    transform:translate(-2px,-2px);
    box-shadow:5px 5px 0 var(--ink);
  }
  .btn:active{
    transform:translate(0,0);
    box-shadow:1px 1px 0 var(--ink);
  }
  .btn-solid{
    background:var(--tape);
    border-color:var(--ink);
  }
  .btn-small{
    padding:7px 13px;
    font-size:12.5px;
    box-shadow:2px 2px 0 var(--ink);
  }
  .btn-small:hover{ transform:translate(-1px,-1px); box-shadow:3px 3px 0 var(--ink);}

  /* ---------- HERO / CORKBOARD ---------- */
  .hero{
    position:relative;
    padding:76px 32px 40px;
    overflow:hidden;
  }
  .hero-inner{
    max-width:1180px;
    margin:0 auto;
    display:grid;
    grid-template-columns:0.95fr 1.05fr;
    gap:20px;
    align-items:center;
  }
  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:0.14em;
    color:var(--verified);
    background:rgba(63,122,84,0.1);
    border:1px solid rgba(63,122,84,0.35);
    padding:5px 10px 5px 8px;
    border-radius:20px;
    margin-bottom:20px;
  }
  .eyebrow .pulse{
    width:7px;height:7px;border-radius:50%;
    background:var(--verified);
    box-shadow:0 0 0 3px rgba(63,122,84,0.18);
  }
  .hero h1{
    font-size:clamp(38px, 4.6vw, 60px);
    line-height:1.03;
    font-weight:700;
  }
  .hero h1 .underline{
    position:relative;
    white-space:nowrap;
  }
  .hero h1 .underline svg{
    position:absolute;
    left:0; bottom:-6px;
    width:100%; height:14px;
  }
  .hero p.sub{
    margin-top:22px;
    font-size:17.5px;
    line-height:1.55;
    color:var(--ink-soft);
    max-width:46ch;
  }
  .hero-ctas{
    display:flex;
    gap:14px;
    margin-top:32px;
    flex-wrap:wrap;
  }
  .hero-stats{
    display:flex;
    gap:28px;
    margin-top:40px;
    padding-top:22px;
    border-top:1px dashed var(--line);
  }
  .stat-num{
    font-family:'Space Grotesk', sans-serif;
    font-size:24px;
    font-weight:700;
  }
  .stat-label{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:var(--ink-soft);
    text-transform:uppercase;
    letter-spacing:0.08em;
  }

  /* the corkboard */
  .board{
    position:relative;
    background:
      repeating-linear-gradient(0deg, rgba(0,0,0,0.02) 0px, rgba(0,0,0,0.02) 1px, transparent 1px, transparent 3px),
      #C99A62;
    background-color:#C99A62;
    border:10px solid #7A5A38;
    border-radius:6px;
    min-height:480px;
    box-shadow:inset 0 0 40px rgba(0,0,0,0.25), 8px 10px 0 rgba(31,43,34,0.9);
    padding:26px;
  }
  .board::before{
    content:"";
    position:absolute;
    inset:10px;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(0,0,0,0.08) 0, transparent 3%),
      radial-gradient(circle at 70% 60%, rgba(0,0,0,0.08) 0, transparent 4%),
      radial-gradient(circle at 40% 80%, rgba(0,0,0,0.07) 0, transparent 3%),
      radial-gradient(circle at 85% 15%, rgba(0,0,0,0.07) 0, transparent 3%);
    pointer-events:none;
  }
  .pin-card{
    position:absolute;
    width:190px;
    background:var(--card);
    border-radius:2px;
    padding:12px 12px 14px;
    box-shadow:0 8px 16px rgba(0,0,0,0.28);
  }
  .pin-card img.thumb{
    width:100%;
    height:96px;
    object-fit:cover;
    border-radius:2px;
    margin-bottom:8px;
    background:var(--paper-dim);
  }
  .pin-card .ttl{
    font-size:13.5px;
    font-weight:600;
    line-height:1.25;
  }
  .pin-card .meta{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-top:7px;
  }
  .pin-card .price{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    font-weight:600;
    color:var(--library-dark);
  }
  .pin-card .badge{
    font-family:'IBM Plex Mono', monospace;
    font-size:9px;
    color:var(--verified);
    text-transform:uppercase;
    letter-spacing:0.06em;
  }
  .pushpin{
    position:absolute;
    top:-9px; left:50%;
    transform:translateX(-50%);
    width:16px; height:16px;
    border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #ff8a8a, #b52c2c 70%);
    box-shadow:0 3px 3px rgba(0,0,0,0.4);
    z-index:3;
  }
  .tape{
    position:absolute;
    width:64px; height:22px;
    background:rgba(232,182,44,0.75);
    box-shadow:0 2px 3px rgba(0,0,0,0.15);
    z-index:3;
  }
  .card-1{ top:14px; left:14px; transform:rotate(-4deg); }
  .card-2{ top:26px; right:18px; transform:rotate(3deg); }
  .card-3{ bottom:20px; left:60px; transform:rotate(2deg); }
  .card-4{ bottom:36px; right:36px; transform:rotate(-3deg); width:170px;}

  .board-note{
    position:absolute;
    bottom:16px; left:18px;
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:rgba(255,255,255,0.75);
    letter-spacing:0.04em;
  }

  /* ---------- TRUST STRIP ---------- */
  .trust{
    border-top:2px solid var(--ink);
    border-bottom:2px solid var(--ink);
    background:var(--ink);
    color:var(--paper);
    padding:14px 0;
    overflow:hidden;
  }
  .trust-track{
    <span class="trust-item">✓ QR Pickup Verification <span class="sep">/</span></span>

<span class="trust-item">✓ OTP Return Confirmation <span class="sep">/</span></span>

<span class="trust-item">✓ Automatic Late Fee <span class="sep">/</span></span>

<span class="trust-item">✓ Damage Protection <span class="sep">/</span></span>

<span class="trust-item">✓ Smart Return Reminders <span class="sep">/</span></span>
    display:flex;
    gap:56px;
    white-space:nowrap;
    animation:scroll 26s linear infinite;
    width:max-content;
  }
  @keyframes scroll{
    from{transform:translateX(0);}
    to{transform:translateX(-50%);}
  }
  .trust-item{
    font-family:'IBM Plex Mono', monospace;
    font-size:12.5px;
    text-transform:uppercase;
    letter-spacing:0.1em;
    display:flex;
    align-items:center;
    gap:10px;
    opacity:0.9;
  }
  .trust-item .sep{ opacity:0.4; }

  /* ---------- SECTION HEADERS ---------- */
  section{ padding:84px 32px; }
  .sec-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    margin-bottom:42px;
    gap:24px;
    flex-wrap:wrap;
  }
  .sec-index{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color:var(--library-dark);
    text-transform:uppercase;
    letter-spacing:0.14em;
    margin-bottom:10px;
    display:block;
  }
  .sec-head h2{
    font-size:clamp(26px,3vw,36px);
    font-weight:700;
  }
  .sec-head p{
    max-width:38ch;
    color:var(--ink-soft);
    font-size:15px;
    line-height:1.5;
  }

  /* ---------- CATEGORY CATALOG ---------- */
  .catalog{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:14px;
  }
  .cat-card{
    background:var(--card);
    border:1px solid var(--line);
    border-top:3px solid var(--library);
    border-radius:2px;
    padding:20px 14px;
    text-align:left;
    cursor:pointer;
    transition:transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    position:relative;
  }
  .cat-card:hover{
    transform:translateY(-4px);
    box-shadow:0 10px 18px rgba(31,43,34,0.12);
  }
  .cat-card .cat-code{
    font-family:'IBM Plex Mono', monospace;
    font-size:10.5px;
    color:var(--ink-soft);
    display:block;
    margin-bottom:14px;
  }
  .cat-card .cat-icon{ margin-bottom:10px; }
  .cat-card .cat-name{
    font-weight:600;
    font-size:14.5px;
  }
  .cat-card .cat-count{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:var(--ink-soft);
    margin-top:4px;
    display:block;
  }

  /* ---------- LISTINGS ---------- */
  .filter-row{
    display:flex;
    gap:10px;
    margin-bottom:30px;
    flex-wrap:wrap;
  }
  .chip{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    padding:8px 14px;
    border:1px solid var(--ink);
    border-radius:20px;
    background:transparent;
    cursor:pointer;
    text-transform:uppercase;
    letter-spacing:0.04em;
  }
  .chip.active{
    background:var(--ink);
    color:var(--paper);
  }
  .listings-grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:22px;
  }
  .listing{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:3px;
    overflow:hidden;
    transition:transform 0.15s ease, box-shadow 0.15s ease;
    display:flex;
    flex-direction:column;
  }
  .listing:hover{
    transform:translateY(-5px);
    box-shadow:0 14px 24px rgba(31,43,34,0.14);
  }
  .listing .photo{
    height:150px;
    background:var(--paper-dim);
    position:relative;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .listing .avail{
    position:absolute;
    top:10px; left:10px;
    background:var(--verified);
    color:#fff;
    font-family:'IBM Plex Mono', monospace;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:0.05em;
    padding:4px 8px;
    border-radius:20px;
  }
  .listing .save{
    position:absolute;
    top:10px; right:10px;
    width:28px; height:28px;
    border-radius:50%;
    background:rgba(255,255,255,0.85);
    display:flex;align-items:center;justify-content:center;
    cursor:pointer;
  }
  .listing .body{
    padding:14px 15px 16px;
    flex:1;
    display:flex;
    flex-direction:column;
  }
  .listing .ttl{
    font-weight:600;
    font-size:15px;
    margin-bottom:5px;
  }
  .listing .loc{
    font-size:12.5px;
    color:var(--ink-soft);
    margin-bottom:12px;
    display:flex;
    align-items:center;
    gap:5px;
  }
  .listing .foot{
    margin-top:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding-top:10px;
    border-top:1px dashed var(--line);
  }
  .listing .price{
    font-family:'IBM Plex Mono', monospace;
    font-weight:600;
    font-size:14.5px;
  }
  .listing .price span{
    font-size:11px;
    color:var(--ink-soft);
    font-weight:400;
  }
  .listing .owner{
    display:flex;
    align-items:center;
    gap:6px;
    font-size:11px;
    color:var(--ink-soft);
  }
  .avatar{
    width:20px;height:20px;border-radius:50%;
    background:var(--library);
    color:#fff;
    font-family:'IBM Plex Mono', monospace;
    font-size:9px;
    display:flex;align-items:center;justify-content:center;
    font-weight:600;
  }

  /* ---------- HOW IT WORKS: CHECKOUT CARD ---------- */
  .how{
    background:var(--ink);
    color:var(--paper);
    border-radius:6px;
    padding:52px 44px;
    position:relative;
  }
  .how .sec-index{ color:var(--tape); }
  .how h2{ color:var(--paper); }
  .how > p.lede{
    max-width:44ch;
    color:rgba(244,239,227,0.7);
    margin-top:14px;
    font-size:15px;
    line-height:1.55;
  }
  .checkout-card{
    margin-top:44px;
    background:var(--paper);
    color:var(--ink);
    border-radius:3px;
    padding:0;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    overflow:hidden;
    border:1px solid rgba(0,0,0,0.08);
  }
  .checkout-row{
    padding:28px 26px;
    position:relative;
  }
  .checkout-row + .checkout-row{
    border-left:1px dashed var(--line);
  }
  .checkout-row .stamp{
    display:inline-block;
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    font-weight:600;
    text-transform:uppercase;
    letter-spacing:0.08em;
    color:var(--verified);
    border:1.5px solid var(--verified);
    border-radius:3px;
    padding:3px 8px;
    transform:rotate(-3deg);
    margin-bottom:18px;
  }
  .checkout-row h3{
    font-size:17px;
    margin-bottom:8px;
  }
  .checkout-row p{
    font-size:13.5px;
    color:var(--ink-soft);
    line-height:1.5;
    margin:0;
  }
  .checkout-row .step-icon{ margin-bottom:16px; }
  <section id="dashboard">
